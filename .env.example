# Copy to .env to keep your settings between runs:  cp .env.example .env
# Precedence: command-line flags > variables exported in your shell > this file > built-in defaults.
# Only SENJIN_* names are read from this file. Lines starting with # are ignored.

# Interview length for tools that read no candidate (senjin-chat --no-tools, senjin-sim).
# Candidate interviews take their shape from <candidate-dir>/interview.yaml instead.
# Questions asked in the background + technical parts (2 to 30)
#SENJIN_MAX_QUESTIONS=5
# Follow-ups after each technical question, 0 to 3 (each technical question is separate)
#SENJIN_FOLLOW_UPS=1
# How many of those are about the resume (default: about 40%, at least 1)
#SENJIN_RESUME_QUESTIONS=2
# Time box for the whole interview, in minutes
#SENJIN_MAX_MINUTES=30
# Silence before "Are you still there?" in seconds (0 = off)
#SENJIN_IDLE_SECONDS=25

# Voice timing
# Silence that ends the candidate's turn, in ms (200 to 3000). Raise it if answers get cut off.
#SENJIN_SILENCE_MS=1000
# After a short or trailing-off answer, wait this long for the candidate to carry on (0 = off)
#SENJIN_HOLD_MS=1500
# Play "Okay, right." or "I see." if no reply has started this long after the candidate stops (0 = off)
#SENJIN_FILLER_MS=1100

# How slowly Senjin speaks: 1.0 is the voice's normal speed, 1.2 is 20% slower (0.8 to 1.6)
#SENJIN_VOICE_PACE=1.2

# A local decision model double-checks "has the candidate finished the Q&A?" (needs Ollama 0.35+
# and `ollama pull nimble`). Off when empty: the rules decide alone.
#SENJIN_DECISION_MODEL=nimble

# The candidate folder is not a setting: pass --candidate-dir to senjin-review, senjin-meet run,
# senjin-voice run and senjin-assess. Run senjin-review first to write its questions.yaml.

# Use a different env file (empty value = ignore .env files)
#SENJIN_ENV_FILE=
